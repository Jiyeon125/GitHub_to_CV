# =========================================================
# GitHub OAuth (NextAuth) - 로그인/private repo 분석에 필요
# =========================================================
# 1) https://github.com/settings/developers → New OAuth App
# 2) Homepage URL:
#    - local: http://localhost:3000
#    - production: https://github-to-cvjiyeon125.vercel.app
# 3) Authorization callback URL:
#    - local: http://localhost:3000/api/auth/callback/github
#    - production: https://github-to-cvjiyeon125.vercel.app/api/auth/callback/github
# 4) 생성된 Client ID / Client Secret 을 아래에 입력
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth JWT 서명/암호화에 사용. 32바이트 이상의 임의 문자열.
# 생성 예시: openssl rand -base64 32
NEXTAUTH_SECRET=

# 개발 환경에서는 보통 자동 감지되지만, 명시하면 더 안전.
# 배포 시에는 실제 호스트로 변경.
NEXTAUTH_URL=http://localhost:3000

# =========================================================
# (선택) GitHub Personal Access Token
# =========================================================
# 로그인하지 않은 게스트 모드에서 GitHub API 호출 한도(시간당 60회) 를
# 늘리고 싶을 때만 설정합니다. 로그인 사용자의 self 모드에서는 본인의
# OAuth access token 이 우선 사용되므로 영향이 없습니다.
GITHUB_TOKEN=

# =========================================================
# 숙명여자대학교 API Gateway (Mindlogic factchat)
# =========================================================
# OpenAI 호환 Chat Completions 형식이라 base URL 만 바꿔 동일하게 호출합니다.
# 문서: https://docs.mindlogic.ai/docs/sookmyung/gateway/getting-started/overview
MINDLOGIC_API_KEY=

# (선택) base URL 오버라이드. 기본값은 아래와 동일.
# MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# (선택) 모델 오버라이드. 게이트웨이가 지원하는 모델 ID 사용.
# 예: claude-sonnet-4-6, gpt-4o-mini, gemini-2.0-flash 등
# MINDLOGIC_MODEL=claude-sonnet-4-6

# === LLM 재현성 옵션 (선택) ===
# 기본값 0 으로 두면 거의 결정적으로 동작합니다.
# 약간의 어휘 다양성을 원하면 0.2 ~ 0.5 사이로 조정.
# LLM_TEMPERATURE=0

# GitHub API 호출 한도를 늘리기 위한 personal access token (없어도 동작)
GITHUB_TOKEN=

# LLM 통합 (둘 중 하나만 설정해도 동작; 둘 다 비어 있으면 LLM 호출 생략)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# LLM 재현성 옵션 (선택)
# - 기본값 0 으로 두면 OpenAI 는 seed 와 함께 거의 결정적으로 동작합니다.
# - Gemini 는 native seed 가 없어 topK=1 + topP=1 + temperature=0 로 그리디 디코딩에 가깝게 처리합니다.
# - 약간의 어휘 다양성을 원하면 0.2 ~ 0.5 사이로 조정.
# LLM_TEMPERATURE=0
